# Environment Configuration Template
# Copy this file to .env.local for development or .env.production for production
# DO NOT commit .env.local or .env.production to git

# Database connection
DB_HOST=mongodb://localhost:27017/rankey

# Server port
PORT=7000

# Session secret (use a strong random value in production)
# Generate with: openssl rand -base64 48
SESSION_SECRET=your-secret-here

# Environment mode (development or production)
NODE_ENV=development

# Frontend URL for CORS (must match your frontend origin)
# Local development: http://localhost:5173
# Production: https://rankey-staging-ui.onrender.com
FRONTEND_URL=http://localhost:5173

# ScrapingBee API Key
SCRAPINGBEE_API_KEY=your-scrapingbee-key-here

# ScrapingDog API Key
SCRAPINGDOG_API_KEY=your-scrapingdog-key-here
